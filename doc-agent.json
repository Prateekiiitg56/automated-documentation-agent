    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst raw = response.choices[0].message.content;\n\n// remove markdown code blocks safely\nconst cleaned = raw\n  .replace(\"```json\", \"\")\n  .replace(\"```\", \"\")\n  .trim();\n\nconst videoData = JSON.parse(cleaned);\n\nreturn [{\n  json: {\n    ...$('Code in JavaScript1').first().json,\n    video_data: JSON.stringify(videoData)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",

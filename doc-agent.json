    {
      "parameters": {
        "jsCode": "const data = JSON.parse($input.first().json.video_data);\n\n// Format as readable markdown video script\nlet markdown = `# Video Script — PR #${$input.first().json.pr_number}\\n\\n`;\nmarkdown += `## Voiceover Script\\n${data.voiceover}\\n\\n`;\nmarkdown += `## Slides\\n`;\n\ndata.slides.forEach((slide, i) => {\n  markdown += `### Slide ${i+1}: ${slide.title}\\n- ${slide.bullet}\\n\\n`;\n});\n\nconst encoded = Buffer.from(markdown).toString('base64');\n\nreturn [{\n  json: {\n    ...$('Code in JavaScript1').first().json,\n    script_b64: encoded\n  }\n}];"
      },

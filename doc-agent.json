    {
      "parameters": {
        "jsCode": "const files = $input.all();\nlet diffText = \"\";\n\nfor (const file of files) {\n  const filename = file.json.filename;\n  const patch = file.json.patch || \"(binary file or no changes)\";\n  \n  diffText += `\\n\\n--- ${filename} ---\\n${patch}`;\n}\n\nconst trimmedDiff = diffText.slice(0, 4000);\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    diff: trimmedDiff\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",

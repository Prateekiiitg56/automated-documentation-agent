        "jsonBody": "={{\n{\n  model: \"llama-3.3-70b-versatile\",\n  max_tokens: 1000,\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a technical content creator. Return ONLY valid JSON.\"\n    },\n    {\n      role: \"user\",\n      content:\n        \"Create a 1-minute video script for this GitHub feature.\\n\\n\" +\n        \"Title: \" + $json.pr_title + \"\\n\\n\" +\n        \"Description:\\n\" + ($json.pr_body || \"\")\n    }\n  ]\n}\n}}",

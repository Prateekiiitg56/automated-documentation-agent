        "jsonBody": "={{\n{\n  model: \"llama-3.3-70b-versatile\",\n  max_tokens: 2000,\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a senior developer writing technical blogs. Return only markdown. No preamble.\"\n    },\n    {\n      role: \"user\",\n      content:\n        \"Write a technical blog post about this merged feature:\\n\\n\" +\n        \"Title: \" + ($json.pr_title || \"\") + \"\\n\" +\n        \"Description: \" + ($json.pr_body || \"No description provided\") + \"\\n\" +\n        \"Code changes:\\n\" + ($json.diff || \"\") + \"\\n\\n\" +\n        \"Structure: # Title, ## Introduction, ## What Changed, ## Why It Matters, ## Code Example, ## Conclusion\"\n    }\n  ]\n}\n}}",

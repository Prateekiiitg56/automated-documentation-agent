      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst blogContent = response.choices[0].message.content;\n\n// Encode for GitHub\nconst encoded = Buffer.from(blogContent).toString('base64');\nconst prNumber = $('Code in JavaScript1').first().json.pr_number;\n\nreturn [{\n  json: {\n    ...$('Code in JavaScript1').first().json,\n    blog_b64: encoded,\n    blog_path: `docs/blog/pr-${prNumber}.md`\n  }\n}];"
      },

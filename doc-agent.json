        "jsCode": "const response = $input.first().json;\nconst updatedReadme = response.choices[0].message.content;\n\n// GitHub needs base64 encoded content\nconst encoded = Buffer.from(updatedReadme).toString('base64');\n\nreturn [{\n  json: {\n    ...$('Code in JavaScript1').first().json,\n    updated_readme_b64: encoded\n  }\n}];"

      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst readme = Buffer.from(item.content, 'base64').toString('utf-8');\nconst sha = item.sha;\n\nreturn [{\n  json: {\n    ...$('Edit Fields').first().json,\n    diff: $('Code in JavaScript').first().json.diff,\n    current_readme: readme,\n    readme_sha: sha\n  }\n}];"
